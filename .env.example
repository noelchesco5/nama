# nama - environment template. Copy to .env (gitignored) and fill in.
# Never commit real values. In CI these come from GitHub Actions secrets.

# --- Supabase (client-safe) ---
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only - edge functions, CI, scripts) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=xxxxxxxxxxxx
# Personal access token for the Supabase CLI / CI migrations
SUPABASE_ACCESS_TOKEN=
# Direct Postgres connection. On Supabase the db.<ref> host is IPv6-only, so use
# the IPv4 pooler: postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- HQ seed (run scripts/seed-hq.mjs) ---
HQ_EMAIL=nama@nama.com
HQ_DISPLAY_NAME=Nama
HQ_INITIAL_PASSWORD=

# --- Routing and maps (server / config only) ---
ORS_API_KEY=
MAP_TILES_KEY=

# --- SMS / OTP (Textify Africa) ---
TEXTIFY_API_KEY=

# --- Phase 4 ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
