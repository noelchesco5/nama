{
  "name": "nama",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:sql": "for f in supabase/tests/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\"; done",
    "seed:hq": "node --env-file-if-exists=.env scripts/seed-hq.mjs",
    "smoke:auth": "node --env-file-if-exists=.env scripts/smoke-auth.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "typescript": "^5.9.3"
  }
}
